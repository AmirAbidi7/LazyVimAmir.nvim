{
  "Spring Boot PostgreSQL": {
    "prefix": "sbpg",
    "body": [
      "spring:",
      "  datasource:",
      "    url: jdbc:postgresql://${1:localhost}:${2:5432}/${3:mydb}",
      "    username: ${4:postgres}",
      "    password: ${5:password}",
      "    driver-class-name: org.postgresql.Driver",
      "  jpa:",
      "    hibernate:",
      "      ddl-auto: ${6:update}",
      "    properties:",
      "      hibernate:",
      "        dialect: org.hibernate.dialect.PostgreSQLDialect",
      "        show_sql: ${7:true}",
      "        format_sql: ${8:true}"
    ],
    "description": "Spring Boot PostgreSQL database configuration"
  },
  "Spring Boot MySQL": {
    "prefix": "sbmysql",
    "body": [
      "spring:",
      "  datasource:",
      "    url: jdbc:mysql://${1:localhost}:${2:3306}/${3:mydb}?useSSL=${4:false}&serverTimezone=${5:UTC}",
      "    username: ${6:root}",
      "    password: ${7:password}",
      "    driver-class-name: com.mysql.cj.jdbc.Driver",
      "  jpa:",
      "    hibernate:",
      "      ddl-auto: ${8:update}",
      "    properties:",
      "      hibernate:",
      "        dialect: org.hibernate.dialect.MySQL8Dialect",
      "        show_sql: ${9:true}",
      "        format_sql: ${10:true}"
    ],
    "description": "Spring Boot MySQL database configuration"
  },
  "Spring Boot H2": {
    "prefix": "sbh2",
    "body": [
      "spring:",
      "  datasource:",
      "    url: jdbc:h2:mem:${1:testdb};DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE",
      "    username: ${2:sa}",
      "    password: ${3:}",
      "    driver-class-name: org.h2.Driver",
      "  h2:",
      "    console:",
      "      enabled: ${4:true}",
      "  jpa:",
      "    hibernate:",
      "      ddl-auto: ${5:create-drop}",
      "    properties:",
      "      hibernate:",
      "        dialect: org.hibernate.dialect.H2Dialect",
      "        show_sql: ${6:true}",
      "        format_sql: ${7:true}"
    ],
    "description": "Spring Boot H2 in-memory database for testing"
  },
  "Spring Boot MongoDB": {
    "prefix": "sbmongo",
    "body": [
      "spring:",
      "  data:",
      "    mongodb:",
      "      host: ${1:localhost}",
      "      port: ${2:27017}",
      "      database: ${3:mydb}",
      "      username: ${4:}",
      "      password: ${5:}",
      "      authentication-database: ${6:admin}"
    ],
    "description": "Spring Boot MongoDB configuration"
  },
  "Spring Boot Oracle": {
    "prefix": "sboracle",
    "body": [
      "spring:",
      "  datasource:",
      "    url: jdbc:oracle:thin:@${1:localhost}:${2:1521}:${3:XE}",
      "    username: ${4:system}",
      "    password: ${5:password}",
      "    driver-class-name: oracle.jdbc.OracleDriver",
      "  jpa:",
      "    hibernate:",
      "      ddl-auto: ${6:update}",
      "    properties:",
      "      hibernate:",
      "        dialect: org.hibernate.dialect.Oracle12cDialect",
      "        show_sql: ${7:true}",
      "        format_sql: ${8:true}"
    ],
    "description": "Spring Boot Oracle database configuration"
  },
  "Spring Boot SQL Server": {
    "prefix": "sbsqlserver",
    "body": [
      "spring:",
      "  datasource:",
      "    url: jdbc:sqlserver://${1:localhost}:${2:1433};databaseName=${3:mydb}",
      "    username: ${4:sa}",
      "    password: ${5:password}",
      "    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver",
      "  jpa:",
      "    hibernate:",
      "      ddl-auto: ${6:update}",
      "    properties:",
      "      hibernate:",
      "        dialect: org.hibernate.dialect.SQLServer2012Dialect",
      "        show_sql: ${7:true}",
      "        format_sql: ${8:true}"
    ],
    "description": "Spring Boot SQL Server configuration"
  },
  "Spring Boot PostgreSQL with R2DBC": {
    "prefix": "sbpg-reactive",
    "body": [
      "spring:",
      "  r2dbc:",
      "    url: r2dbc:postgresql://${1:localhost}:${2:5432}/${3:mydb}",
      "    username: ${4:postgres}",
      "    password: ${5:password}",
      "  flyway:",
      "    url: jdbc:postgresql://${1:localhost}:${2:5432}/${3:mydb}",
      "    user: ${4:postgres}",
      "    password: ${5:password}",
      "    enabled: ${6:true}"
    ],
    "description": "Spring Boot R2DBC PostgreSQL configuration"
  },
  "Spring Boot Complete Config": {
    "prefix": "sbcomplete",
    "body": [
      "spring:",
      "  datasource:",
      "    url: jdbc:postgresql://${1:localhost}:${2:5432}/${3:mydb}",
      "    username: ${4:postgres}",
      "    password: ${5:password}",
      "    driver-class-name: org.postgresql.Driver",
      "    hikari:",
      "      connection-timeout: ${6:20000}",
      "      maximum-pool-size: ${7:5}",
      "      minimum-idle: ${8:2}",
      "      idle-timeout: ${9:300000}",
      "      max-lifetime: ${10:1200000}",
      "  jpa:",
      "    hibernate:",
      "      ddl-auto: ${11:update}",
      "      naming:",
      "        physical-strategy: org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl",
      "    properties:",
      "      hibernate:",
      "        dialect: org.hibernate.dialect.PostgreSQLDialect",
      "        show_sql: ${12:true}",
      "        format_sql: ${13:true}",
      "        jdbc:",
      "          batch_size: ${14:20}",
      "    open-in-view: ${15:false}",
      "logging:",
      "  level:",
      "    org.hibernate.SQL: ${16:DEBUG}",
      "    org.hibernate.type.descriptor.sql.BasicBinder: ${17:TRACE}"
    ],
    "description": "Spring Boot complete database configuration with connection pooling"
  }
}

